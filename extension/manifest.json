{
  "manifest_version": 3,
  "name": "Bare Cart Helper",
  "description": "Add the items and quantities you choose in Bare to your Amazon US cart.",
  "version": "1.0.0",
  "key": "",
  "permissions": ["storage"],
  "background": { "service_worker": "worker.js" },
  "externally_connectable": {
    "matches": ["https://undeadcommander.github.io/amazon-debloated/*", "http://127.0.0.1/*", "http://localhost/*"]
  },
  "content_scripts": [{
    "matches": ["https://www.amazon.com/gp/cart/view.html*", "https://www.amazon.com/cart*"],
    "js": ["amazon.js"],
    "css": ["amazon.css"],
    "run_at": "document_idle"
  }]
}
